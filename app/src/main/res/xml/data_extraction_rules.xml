<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and above (android:dataExtractionRules). Same two paths as
    backup_rules.xml — see the notes there on why the whole database domain and
    files/datastore/ are the right targets.

    device-transfer is included so moving to a new phone carries the price list
    across even when the user has cloud backup switched off.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
