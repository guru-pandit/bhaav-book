<?xml version="1.0" encoding="utf-8"?>
<!--
    A price tag, centred on 54,54 and kept inside the adaptive-icon safe circle
    (radius 36) so no launcher shape crops it. Gold body, cream outline, punched
    hole in the background maroon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Tag body -->
    <path
        android:fillColor="#C99A2E"
        android:strokeColor="#FBF3E7"
        android:strokeWidth="3"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M33,33 L57,33 L75,51 L51,75 L33,57 Z" />

    <!-- Punched hole -->
    <path
        android:fillColor="#6B1E23"
        android:pathData="M43,43 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 Z" />

    <!-- Rupee stroke, simplified to read at 48dp -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FBF3E7"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M52,48 L64,48 M52,54 L64,54 M62,48 C62,55 56,56 54,56 L62,65" />
</vector>
